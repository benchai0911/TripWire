OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
TARGET_MODEL=
JUDGE_MODEL=
# Empty TARGET_MODEL / JUDGE_MODEL fall back independently to OPENAI_MODEL.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Set to 1 for deterministic, free testing (no API key required).
TRIPWIRE_MOCK=0

# Optional request pacing across all live API calls.
# Default: 10/min for Gemini, 60/min otherwise. Match your provider quota.
# TRIPWIRE_REQUESTS_PER_MINUTE=10

# Optional JSON array replacing the default output guard regex patterns.
# TRIPWIRE_OUTPUT_PATTERNS=["STAFF\\d+", "INTERNAL-\\d+"]

# Batch double judging stays enabled by default. Set 0 for a single batch pass.
TRIPWIRE_DOUBLE_JUDGE=1
# Safe metadata-only cache; 0 disables reuse.
TRIPWIRE_CACHE=1
# JSON list of exact hostnames allowed for markdown images (default denies all).
TRIPWIRE_OUTPUT_ALLOWED_DOMAINS=[]
